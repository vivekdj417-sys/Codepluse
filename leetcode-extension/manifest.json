{
  "manifest_version": 3,
  "name": "CodePulse LeetCode Sync",
  "version": "1.0.0",
  "description": "Sync solved LeetCode problems to CodePulse without manual cookie copying.",
  "permissions": ["tabs", "scripting", "storage", "activeTab", "alarms"],
  "host_permissions": ["https://leetcode.com/*", "http://localhost:4000/*", "http://localhost:5000/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html" }
}